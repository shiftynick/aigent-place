+  for (const bytes of malformed) assert.throws(() => decodeWorldSnapshotBody(bytes), `body: ${Buffer.from(bytes).toString("hex")}`);
+  assert.throws(() => decodeWorldSnapshotDelta(Uint8Array.of(...deltaBytes(), 42, 1, 0x80, 1)));
