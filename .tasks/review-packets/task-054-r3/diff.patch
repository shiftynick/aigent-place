+fn aoi_candidates_from_entities(generation: &ImmutableGeneration) -> Vec<AoiEntity> {
+    generation
+        .entities
+        .values()
+        .map(|entity| {
+            AoiEntity::new(
+                entity.entity_id,
+                entity.position.x(),
+                entity.position.y(),
