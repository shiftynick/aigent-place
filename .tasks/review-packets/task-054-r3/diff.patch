+        let body_bytes = encode_world_snapshot_body(&body);
+        let delta = WorldSnapshotDelta {
+            generation_digest: [0xCD; 32],
+            entered: vec![
+                RealEntityRecord::from_snapshot(&sample_record(10)).expect("valid entity record")
