+    },
+    /// A delta against `baseline_id`.
+    Delta {
+        baseline_id: u64,
+        delta: &'a WorldSnapshotDelta,
+    },
+    /// A resync-required notice. No state reached the wire.
+    ResyncRequired { notice: &'a SnapshotResyncRequired },
+}
